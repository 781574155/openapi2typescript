// @ts-ignore
/* eslint-disable */
{{ requestImportStatement }}
{% if reactQuery %}
{% set shouldGenerateMutation = reactQuery.mutation and hasMutation %}
{% set shouldGenerateInfiniteQuery = hasInfiniteQuery %}
{% if hasQuery %}
import { useQuery } from '{{ reactQuery.importPath }}';
import type { UseQueryOptions } from '{{ reactQuery.importPath }}';
{% endif %}
{% if shouldGenerateInfiniteQuery %}
import { useInfiniteQuery } from '{{ reactQuery.importPath }}';
import type { InfiniteData, UseInfiniteQueryOptions } from '{{ reactQuery.importPath }}';
{% endif %}
{% if shouldGenerateMutation %}
import { useMutation } from '{{ reactQuery.importPath }}';
import type { UseMutationOptions } from '{{ reactQuery.importPath }}';
{% endif %}

{% if hasQuery %}
type ReactQueryHookOptions<TData, TQueryKey extends readonly unknown[]> = Omit<
  UseQueryOptions<TData, unknown, TData, TQueryKey>,
  'queryKey' | 'queryFn'
>;
{% endif %}

{% if shouldGenerateInfiniteQuery %}
type ReactInfiniteQueryHookOptions<
  TQueryFnData,
  TQueryKey extends readonly unknown[],
  TPageParam = number,
> = Omit<
  UseInfiniteQueryOptions<
    TQueryFnData,
    unknown,
    InfiniteData<TQueryFnData, TPageParam>,
    TQueryKey,
    TPageParam
  >,
  'queryKey' | 'queryFn' | 'initialPageParam' | 'getNextPageParam'
>;
{% endif %}

{% if hasQuery or shouldGenerateMutation or shouldGenerateInfiniteQuery %}
type ReactQueryAwaited<T> = T extends PromiseLike<infer U> ? ReactQueryAwaited<U> : T;

type ReactQueryData<TFunction extends (...args: any[]) => any> = ReactQueryAwaited<
  ReturnType<TFunction>
>;
{% endif %}

{% if shouldGenerateMutation %}
type ReactMutationHookOptions<TData, TVariables> = Omit<
  UseMutationOptions<TData, unknown, TVariables>,
  'mutationKey' | 'mutationFn'
>;
{% endif %}
{% endif %}

{% macro bodyType(api) -%}
{%- if api.body.propertiesList -%}
{
  {%- for prop in api.body.propertiesList %}
  {% if prop.schema.description -%}
  /** {{ prop.schema.description }} */
  {% endif -%}
  {{ prop.key }}{{ "?" if not prop.schema.required }}: {{ prop.schema.type }},
  {%- endfor %}
}
{%- else -%}
{{ api.body.type }}
{%- endif -%}
{%- endmacro %}

{% macro serviceCall(api, optionsName) -%}
{{ api.functionName }}(
  {%- if api.params and api.hasParams -%}
  params,
  {%- endif -%}
  {%- if api.body -%}
  body,
  {%- endif -%}
  {%- if api.file -%}
  {%- for file in api.file -%}
  {{file.title | safe}},
  {%- endfor -%}
  {%- endif -%}
  {{ optionsName }}
)
{%- endmacro %}

{% macro infinitePageParamsType(api) -%}
{%- if api.infiniteQuery.nestedPageField -%}
Omit<{{namespace}}.{{api.typeName}}, '{{ api.infiniteQuery.pageParamName }}'> & { '{{ api.infiniteQuery.pageParamName }}'?: Omit<{{ api.infiniteQuery.pageParamType }}, '{{ api.infiniteQuery.nestedPageField }}'> }
{%- else -%}
Omit<{{namespace}}.{{api.typeName}}, '{{ api.infiniteQuery.pageParamName }}'>
{%- endif -%}
{%- endmacro %}

{% macro infinitePagedParams(api) -%}
{%- if api.infiniteQuery.nestedPageField -%}
{ ...params, '{{ api.infiniteQuery.pageParamName }}': { ...params['{{ api.infiniteQuery.pageParamName }}'], '{{ api.infiniteQuery.nestedPageField }}': pageParam } }
{%- else -%}
{ ...params, '{{ api.infiniteQuery.pageParamName }}': pageParam }
{%- endif -%}
{%- endmacro %}

{% macro infiniteServiceCall(api) -%}
{{ api.functionName }}(
  {%- if api.params and api.hasParams -%}
  {{ infinitePagedParams(api) }} as {{namespace}}.{{api.typeName}},
  {%- endif -%}
  {%- if api.body -%}
  body,
  {%- endif -%}
  requestOptions
)
{%- endmacro %}

{% macro mutationServiceCall(api) -%}
{{ api.functionName }}(
  {%- if api.params and api.hasParams -%}
  variables.params,
  {%- endif -%}
  {%- if api.body -%}
  variables.body,
  {%- endif -%}
  {%- if api.file -%}
  {%- for file in api.file -%}
  variables['{{ file.title | safe }}'],
  {%- endfor -%}
  {%- endif -%}
  variables{% if not (api.params and api.hasParams) and not api.body and not api.file %}?{% endif %}.options
)
{%- endmacro %}

{% for api in list -%}
/** {{ api.desc if api.desc else '此处后端没有提供注释' }} {{api.method | upper}} {{ api.pathInComment | safe }} */
export async function {{ api.functionName }}(
{%- if api.params and api.hasParams %}
  // 叠加生成的Param类型 (非body参数swagger默认没有生成对象)
  params
  {%- if genType === "ts" -%}
  : {{namespace}}.{{api.typeName}}
    {# header 入参 -#}
    {% if api.params.header -%}
    & { // header
    {% for param in api.params.header -%}
    {% if param.description -%}
    /** {{ param.description }} */
    {% endif -%}
      '{{ param.name }}'
      {{- "?" if not param.required }}
      {{- (": " + param.type + ";") | safe }}
    {% endfor -%}
    }
    {%- endif -%}
  {%- endif -%}
  {%- if api.hasParams -%}
  {{ "," if api.body or api.file}}
  {%- endif -%}
{%- endif -%}
{%- if api.body -%}
  body
  {%- if genType === "ts" -%}
  : {{ bodyType(api) | safe }}
  {%- endif -%}
  {{ "," if api.file }}
{%- endif %}
{%- if api.file -%}
{%- for file in api.file -%}
{{file.title | safe}}
{%- if genType === "ts" -%}
{{- "?" if not api.file.required -}}
: File {{ "[]" if file.multiple }}
{%- endif -%}
{{"," if not loop.last }}
{%- endfor -%}
{%- endif -%}
{{ "," if api.body or api.hasParams or api.file }}
  options {{ ("?: " + requestOptionsType) if genType === "ts" }}
) {
  {% if api.params and api.params.path -%}
  const { {% for param in api.params.path %}'{{ param.name }}': {{ param.alias }}, {% endfor %}
  {% if api.params.path -%}
  ...queryParams
  {% endif -%}
  } = params;
  {% endif -%}
  {% if api.hasFormData -%}
  const formData = new FormData();
  {% if api.file -%}
  {% for file in api.file %}
  if({{file.title | safe}}){
  {% if file.multiple %}
  {{file.title | safe}}.forEach(f => formData.append('{{file.title | safe}}', f || ''));
  {% else %}
  formData.append('{{file.title | safe}}', {{file.title | safe}})
  {% endif %}
  }
  {% endfor %}
  {%- endif -%}
  {% if api.body %}
  Object.keys(body).forEach(ele => {
    {% if genType === "ts" %}
    const item = (body as any)[ele];
    {% else %}
    const item = body[ele];
    {% endif %}
    if (item !== undefined && item !== null) {
      {% if genType === "ts" %}
      if (typeof item === 'object' && !(item instanceof File)) {
        if (item instanceof Array) {
          item.forEach((f) => formData.append(ele, f || ''));
        } else {
          formData.append(ele, new Blob([JSON.stringify(item)], {type: 'application/json'}));
        }
      } else {
        formData.append(ele, item);
      }
      {% else %}
      formData.append(ele, typeof item === 'object' ? JSON.stringify(item) : item);
      {% endif %}
    }
  });
  {% endif %}
  {% endif -%}

  {% if api.hasPathVariables or api.hasApiPrefix -%}
  return request{{ ("<" + api.response.type + ">") | safe if genType === "ts" }}(`{{ api.path | safe }}`, {
  {% else -%}
  return request{{ ("<" + api.response.type + ">") | safe if genType === "ts" }}('{{ api.path }}', {
  {% endif -%}
    method: '{{ api.method | upper }}',
    {%- if api.hasHeader and api.body.mediaType not in ["multipart/form-data"]%}
    headers: {
      {%- if api.body.mediaType %}
      'Content-Type': '{{ api.body.mediaType | safe }}',
      {%- endif %}
    },
    {%- endif %}
    {%- if api.params and api.hasParams %}
    params: {
      {%- for query in api.params.query %}
        {% if query.schema.default -%}
          // {{query.name | safe}} has a default value: {{ query.schema.default | safe }}
          '{{query.name | safe}}': '{{query.schema.default | safe}}',
        {%- endif -%}
      {%- endfor -%}
      ...{{ 'queryParams' if api.params and api.params.path else 'params' }},
      {%- for query in api.params.query %}
        {%- if query.isComplexType %}
          '{{query.name | safe}}': undefined,
          ...{{ 'queryParams' if api.params and api.params.path else 'params' }}['{{query.name | safe}}'],
        {%- endif %}
      {%- endfor -%}
    },
    {%- endif %}
    {%- if api.hasFormData %}
    data: formData,
    {%- else %}
    {%- if api.body %}
    data: body,
    {%- endif %}
    {%- endif %}
    ...(options || {{api.options | dump}}),
  });
}

{% if reactQuery and api.isQuery %}
export const {{ api.queryKeyName }} = (
  {%- if api.params and api.hasParams -%}
  params: {{namespace}}.{{api.typeName}},
  {%- endif -%}
  {%- if api.body -%}
  body: {{ bodyType(api) | safe }},
  {%- endif -%}
  {%- if api.file -%}
  {%- for file in api.file -%}
  {{file.title | safe}}: File {{ "[]" if file.multiple }},
  {%- endfor -%}
  {%- endif -%}
) => [
  '{{ className }}',
  '{{ api.functionName }}',
  {%- if api.params and api.hasParams -%}
  params,
  {%- endif -%}
  {%- if api.body -%}
  body,
  {%- endif -%}
  {%- if api.file -%}
  {%- for file in api.file -%}
  {{file.title | safe}},
  {%- endfor -%}
  {%- endif -%}
] as const;

export function {{ api.queryHookName }}(
  {%- if api.params and api.hasParams -%}
  params: {{namespace}}.{{api.typeName}},
  {%- endif -%}
  {%- if api.body -%}
  body: {{ bodyType(api) | safe }},
  {%- endif -%}
  {%- if api.file -%}
  {%- for file in api.file -%}
  {{file.title | safe}}: File {{ "[]" if file.multiple }},
  {%- endfor -%}
  {%- endif -%}
  queryOptions?: ReactQueryHookOptions<
    ReactQueryData<typeof {{ api.functionName }}>,
    ReturnType<typeof {{ api.queryKeyName }}>
  >,
  requestOptions?: {{ requestOptionsType }}
) {
  return useQuery<
    ReactQueryData<typeof {{ api.functionName }}>,
    unknown,
    ReactQueryData<typeof {{ api.functionName }}>,
    ReturnType<typeof {{ api.queryKeyName }}>
  >({
    ...(queryOptions || {}),
    queryKey: {{ api.queryKeyName }}(
      {%- if api.params and api.hasParams -%}
      params,
      {%- endif -%}
      {%- if api.body -%}
      body,
      {%- endif -%}
      {%- if api.file -%}
      {%- for file in api.file -%}
      {{file.title | safe}},
      {%- endfor -%}
      {%- endif -%}
    ),
    queryFn: () => {{ serviceCall(api, 'requestOptions') | safe }},
  });
}
{% endif %}

{% if reactQuery and shouldGenerateInfiniteQuery and api.infiniteQuery %}
export const {{ api.infiniteQueryKeyName }} = (
  {%- if api.params and api.hasParams -%}
  params: {{ infinitePageParamsType(api) }},
  {%- endif -%}
  {%- if api.body -%}
  body: {{ bodyType(api) | safe }},
  {%- endif -%}
) => [
  '{{ className }}',
  '{{ api.functionName }}',
  'infinite',
  {%- if api.params and api.hasParams -%}
  params,
  {%- endif -%}
  {%- if api.body -%}
  body,
  {%- endif -%}
] as const;

export function {{ api.infiniteQueryHookName }}(
  {%- if api.params and api.hasParams -%}
  params: {{ infinitePageParamsType(api) }},
  {%- endif -%}
  {%- if api.body -%}
  body: {{ bodyType(api) | safe }},
  {%- endif -%}
  queryOptions?: ReactInfiniteQueryHookOptions<
    ReactQueryData<typeof {{ api.functionName }}>,
    ReturnType<typeof {{ api.infiniteQueryKeyName }}>
  >,
  requestOptions?: {{ requestOptionsType }}
) {
  return useInfiniteQuery<
    ReactQueryData<typeof {{ api.functionName }}>,
    unknown,
    InfiniteData<ReactQueryData<typeof {{ api.functionName }}>, number>,
    ReturnType<typeof {{ api.infiniteQueryKeyName }}>,
    number
  >({
    ...(queryOptions || {}),
    queryKey: {{ api.infiniteQueryKeyName }}(
      {%- if api.params and api.hasParams -%}
      params,
      {%- endif -%}
      {%- if api.body -%}
      body,
      {%- endif -%}
    ),
    queryFn: ({ pageParam }: { pageParam: number }) => {{ infiniteServiceCall(api) | safe }},
    initialPageParam: {{ api.infiniteQuery.firstPageParam }},
    getNextPageParam: (
      lastPage: ReactQueryData<typeof {{ api.functionName }}>,
      _allPages: ReactQueryData<typeof {{ api.functionName }}>[],
      lastPageParam: number
    ) => {
      const page = lastPage?.data{% for field in api.infiniteQuery.dataPath %}?.{{ field }}{% endfor %};
      if (!page) {
        return undefined;
      }
      if (Array.isArray(page.{{ api.infiniteQuery.contentField }}) && page.{{ api.infiniteQuery.contentField }}.length === 0) {
        return undefined;
      }
      const meta = page{% for field in api.infiniteQuery.metadataPath %}?.{{ field }}{% endfor %};
      if (!meta) {
        return undefined;
      }
      {%- if api.infiniteQuery.lastField %}
      if (meta.{{ api.infiniteQuery.lastField }} === true) {
        return undefined;
      }
      {%- endif %}
      {%- if api.infiniteQuery.pageNumberField %}
      const currentPage = typeof meta.{{ api.infiniteQuery.pageNumberField }} === 'number' ? meta.{{ api.infiniteQuery.pageNumberField }} : lastPageParam;
      {%- else %}
      const currentPage = lastPageParam;
      {%- endif %}
      {%- if api.infiniteQuery.totalPagesField %}
      if (typeof meta.{{ api.infiniteQuery.totalPagesField }} === 'number' && currentPage + 1 >= meta.{{ api.infiniteQuery.totalPagesField }}) {
        return undefined;
      }
      {%- endif %}
      return currentPage + 1;
    },
  });
}
{% endif %}

{% if reactQuery and shouldGenerateMutation and not api.isQuery %}
export type {{ api.mutationVariablesTypeName }} = {
  {%- if api.params and api.hasParams %}
  params: {{namespace}}.{{api.typeName}};
  {%- endif %}
  {%- if api.body %}
  body: {{ bodyType(api) | safe }};
  {%- endif %}
  {%- if api.file %}
  {%- for file in api.file %}
  '{{ file.title | safe }}': File {{ "[]" if file.multiple }};
  {%- endfor %}
  {%- endif %}
  options?: {{ requestOptionsType }};
};

export function {{ api.mutationHookName }}(
  mutationOptions?: ReactMutationHookOptions<
    ReactQueryData<typeof {{ api.functionName }}>,
    {{ api.mutationVariablesTypeName }}
  >
) {
  return useMutation<
    ReactQueryData<typeof {{ api.functionName }}>,
    unknown,
    {{ api.mutationVariablesTypeName }}
  >({
    ...(mutationOptions || {}),
    mutationKey: ['{{ className }}', '{{ api.functionName }}'],
    mutationFn: (
      variables{% if not (api.params and api.hasParams) and not api.body and not api.file %}?{% endif %}: {{ api.mutationVariablesTypeName }}
    ) => {{ mutationServiceCall(api) | safe }},
  });
}
{% endif %}

{% endfor -%}
